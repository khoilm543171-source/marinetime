{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"TokenLedger",
  "type":"object",
  "required":["request_id","stage","input_tokens","output_tokens","estimated_cost_usd"],
  "properties":{
    "request_id":{"type":"string"},
    "stage":{"type":"string"},
    "input_tokens":{"type":"integer","minimum":0},
    "output_tokens":{"type":"integer","minimum":0},
    "estimated_cost_usd":{"type":"number","minimum":0},
    "units_created":{"type":"integer","minimum":0},
    "units_accepted":{"type":"integer","minimum":0},
    "units_rejected":{"type":"integer","minimum":0},
    "human_correction_count":{"type":"integer","minimum":0}
  },
  "additionalProperties":true
}
