{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenLedger v2 (legacy usage records supported)",
  "type": "object",
  "required": [
    "timestamp",
    "input_tokens",
    "output_tokens"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.0"
      ]
    },
    "event": {
      "enum": [
        "reserved",
        "usage"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "video_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cache_creation_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cache_read_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "guard_tokens": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "event",
          "request_id",
          "task",
          "prompt_version",
          "model",
          "success"
        ]
      }
    },
    {
      "if": {
        "required": [
          "event"
        ],
        "properties": {
          "event": {
            "const": "reserved"
          }
        }
      },
      "then": {
        "required": [
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "const": false
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
