# Claude provider. `nghimmo` uses an Anthropic-compatible Messages endpoint.
CLAUDE_PROVIDER=nghimmo
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.nghimmo.com
CLAUDE_MODEL=nghi/claude-opus-5
CLAUDE_ANTHROPIC_VERSION=2023-06-01
CLAUDE_TIMEOUT_SECONDS=90

# Backward-compatible names accepted by settings.py
NGHIMMO_API_KEY=
NGHIMMO_BASE_URL=https://api.nghimmo.com
OPUS_MODEL=

GOOGLE_DRIVE_FOLDER_ID=
MARINETIME_DB_PATH=storage/marinetime.sqlite3
